                len(data)//2
            ]
        )

        sort_time = (
            time.perf_counter()
            - start
        )

        print(
            f"N={n} | "
            f"Quickselect="
            f"{quick_time:.6f}s | "
            f"Sort="
            f"{sort_time:.6f}s"
        )


if __name__ == "__main__":
    benchmark()
