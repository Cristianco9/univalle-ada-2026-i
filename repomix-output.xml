  "top_k_sort":           "O(n log n)",
  "quickselect_average":  "O(n)",
  "hash_table":           "O(1)",
  "queue":                "O(1)",
  "mlp_forward":          "O(B * h * output)",
  "mlp_backprop":         "O(B * h * output)"
}
```

